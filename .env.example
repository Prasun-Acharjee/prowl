# Copy to .env and fill in real values.
# EXPO_PUBLIC_ prefix makes these available inside the Expo bundle.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Injected into AndroidManifest.xml at build time via the GOOGLE_MAPS_API_KEY
# manifest placeholder in android/app/build.gradle. Unset means the map renders
# as a blank grey grid.
#
# NOTE: `expo prebuild` regenerates AndroidManifest.xml from app.config.js and
# will write the literal key back into it. If you ever re-run prebuild, restore
# android:value="${GOOGLE_MAPS_API_KEY}" before committing.
GOOGLE_MAPS_API_KEY=your-android-maps-key
