# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Environment — real keys live here; commit only .env.example
.env
.env.*
!.env.example

# Yarn Berry — keep releases/plugins (yarnPath), ignore cache & state
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
