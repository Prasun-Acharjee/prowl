android/build/
android/.gradle/
android/app/build/
android/app/release/
android/local.properties

# iOS is generated by `expo prebuild` when needed
ios/

# Signing / credentials
*.keystore
!android/app/debug.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision

